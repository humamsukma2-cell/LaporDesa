# Supabase Configuration
# Copy file ini ke .env lalu isi dengan kredensial project Supabase Anda.
# JANGAN commit file .env ke Git!

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# PENTING:
# - Hanya gunakan ANON KEY di aplikasi mobile.
# - JANGAN PERNAH taruh SERVICE_ROLE KEY di sini!
# - Service role key hanya untuk backend/server-side.
